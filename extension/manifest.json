{
  "manifest_version": 3,
  "name": "Memlio",
  "version": "0.1.0",
  "description": "Save the current tab into your local memlio collection, where Claude Code, Codex, and Copilot CLI can find it.",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "action": {
    "default_title": "Save to memlio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Save the current tab to memlio"
    }
  }
}
